{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "line.schema.json",
  "title": "Software Factory Line (schema v2)",
  "description": "A Line under lines/. Mirrors src/line-schema.ts; cross-file rules (station order, artifact origin, retry targets, operator profiles) are checked by factory check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "workspace",
    "operators",
    "stations",
    "deliver"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "workspace": { "$ref": "#/definitions/workspace" },
    "operators": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/definitions/operator" }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/operatorStation" },
          { "$ref": "#/definitions/inspectionStation" }
        ]
      }
    },
    "deliver": { "$ref": "#/definitions/deliver" }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(s|m|h)$",
      "description": "A duration like 30s, 20m or 1h"
    },
    "machineText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "A shell command: no paths, hosts, panes or host:port"
    },
    "commandBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout", "exec"],
      "properties": {
        "timeout": { "$ref": "#/definitions/duration" },
        "exec": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/machineText" }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup"],
      "properties": {
        "sync": { "$ref": "#/definitions/commandBlock" },
        "setup": { "$ref": "#/definitions/commandBlock" }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "runner", "model", "timeout"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "runner": {
          "type": "string",
          "enum": ["claude", "codex", "cursor", "antigravity", "opencode"]
        },
        "model": { "type": "string", "minLength": 1 },
        "timeout": { "$ref": "#/definitions/duration" },
        "headless": { "type": "boolean", "default": false },
        "permission": {
          "type": "string",
          "enum": ["read", "write"],
          "default": "write"
        }
      }
    },
    "stationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "not": { "enum": ["task", "operator"] }
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "inputRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-zA-Z0-9]*$",
      "description": "<stationId>.<artifactKey> or <stationId>.gate"
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.(?!gate$)[a-z][a-zA-Z0-9]*$",
      "description": "<stationId>.<artifactKey>"
    },
    "onFail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry", "max"],
      "properties": {
        "retry": { "$ref": "#/definitions/stationId" },
        "max": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "operatorStation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "operator"],
      "properties": {
        "id": { "$ref": "#/definitions/stationId" },
        "kind": { "const": "operator" },
        "operator": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "inputs": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/definitions/inputRef" }
        },
        "requires": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "items": { "$ref": "#/definitions/tag" }
        },
        "onFail": { "$ref": "#/definitions/onFail" },
        "maxRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "maxLostRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 3
        }
      }
    },
    "inspectionStation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timeout", "exec"],
      "properties": {
        "id": { "$ref": "#/definitions/stationId" },
        "kind": { "const": "inspection" },
        "timeout": { "$ref": "#/definitions/duration" },
        "exec": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/definitions/machineText" }
        },
        "requires": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "items": { "$ref": "#/definitions/tag" }
        },
        "onFail": { "$ref": "#/definitions/onFail" },
        "maxRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "maxLostRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 3
        }
      }
    },
    "deliver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "report", "to"],
      "properties": {
        "commit": { "$ref": "#/definitions/artifactRef" },
        "report": { "$ref": "#/definitions/artifactRef" },
        "to": { "const": "new-pr" }
      }
    }
  }
}
