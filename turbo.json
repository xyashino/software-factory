{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalEnv": [
    "CI",
    "NO_COLOR",
    "FACTORY_DATA_DIR",
    "FACTORY_DB_PATH",
    "FACTORY_PORT",
    "FACTORY_HOST",
    "FACTORY_URL",
    "CELL_NAME",
    "CELL_SERVER_URL",
    "XDG_DATA_HOME",
    "SF_WEB_DIR"
  ],
  "tasks": {
    "//#format:check": {
      "inputs": [
        "**/*.{ts,tsx,json,yaml,css,js,jsx}",
        ".prettierrc*",
        "!**/node_modules/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["build", "^check-types"]
    },
    "db:check": {
      "inputs": [
        "src/**",
        "drizzle/**",
        "drizzle.config.ts",
        "scripts/**",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "FACTORY_PROPERTY_RUNS",
        "PATH",
        "FAKE_GH_DIR",
        "FAKE_OBSERVE_LOG",
        "FAKE_RUNNER_LOG",
        "FAKE_RUNNER_SCENARIOS"
      ]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
