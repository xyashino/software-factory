# Litestream: continuous replication of factory.db to S3-compatible storage (STORAGE §7, option 1).
# Copy to /etc/litestream.yml and fill in the bucket. Credentials come from the environment
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY), never from this file.
#
# Single writer: factory-server is the only process that writes factory.db. It runs SQLite in WAL
# mode, and Litestream reads the WAL continuously, so no write is lost between snapshots. Do not
# point two Factories at one replica path: each restore assumes one writer history.
#
# Run as a service next to factory-server:
#   litestream replicate -config /etc/litestream.yml
# Restore: deploy/RESTORE.md, section A.

dbs:
  - path: /var/lib/factory/factory.db
    replicas:
      - type: s3
        bucket: CHANGE-ME-factory-backups
        path: factory/main
        endpoint: https://s3.example.com
        region: auto
        # How long replicated WAL and snapshots are kept.
        retention: 720h
        # How often the WAL is shipped. A crash loses at most about this much work (before the Cell
        # leases expire and the job restarts on the last committed Cycle).
        sync-interval: 1s
        # A full snapshot per day keeps restores short.
        snapshot-interval: 24h
