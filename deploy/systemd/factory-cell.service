# factory-cell: runs Jobs for factory-server (PROTOCOL §2, §9).
# Local mode: the Cell is a client of factory.sock, so it runs as the same user as factory-server.
# Remote mode: set FACTORY_JOIN_TOKEN in /etc/factory/factory-cell.env (the join token is read once,
# the Cell keeps its own credential afterwards), and set factory_url in the Cell's config.toml.
# The Cell runs in one repository: --repo-dir (and WorkingDirectory) name its root, and the Cell keeps
# its state in <repo>/.factory-local/cell. Change /var/lib/factory/repo to the checkout this Cell serves.
# Install: copy to /etc/systemd/system/, then systemctl enable --now factory-cell

[Unit]
Description=Software Factory Cell
Documentation=file:///opt/software-factory/deploy/RESTORE.md
After=factory-server.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/factory/factory-cell.env
Environment=FACTORY_DATA_DIR=/var/lib/factory
Environment=XDG_CONFIG_HOME=%S/factory-cell/config
WorkingDirectory=/var/lib/factory/repo
# The binary must be on the PATH of the unit: `factory-cell` from the package that installs it.
ExecStart=/usr/bin/env factory-cell --repo-dir /var/lib/factory/repo
Restart=on-failure
RestartSec=5

# SIGTERM is a graceful leave: live stations are asked to hand over, and the leave waits at most
# LEAVE_CAP_MS (5 min, apps/cell/src/leave.ts). The stop timeout must be longer than that.
KillSignal=SIGTERM
TimeoutStopSec=330

User=factory
Group=factory
StateDirectory=factory-cell
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/factory/repo
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
