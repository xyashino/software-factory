{
  "name": "@repo/sf",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "sf": "./src/cli.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "bun --bun vitest run",
    "build": "bun build src/cli.ts --outfile dist/sf.js --target bun",
    "build:sf": "bun build --compile src/cli.ts --outfile dist/sf"
  },
  "dependencies": {
    "@repo/hq-contracts": "workspace:*",
    "@repo/zod-contract-kit": "workspace:*",
    "citty": "catalog:",
    "picocolors": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
