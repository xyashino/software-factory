---
import Base from '../../layouts/Base.astro';
import { failureResponse } from '../../lib/page-error';
import { createSessionClient } from '../../lib/session';
import { formatTimestamp } from '../../lib/view-model';

const session = await createSessionClient(process.env).catch(failureResponse);
if (session instanceof Response) return session;
const { client } = session;
const reply = await client.listFactories().catch(failureResponse);
if (reply instanceof Response) return reply;
---

<Base>
  <h1>Factories</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Online</th>
        <th>Last seen</th>
        <th>Projects (desired / running)</th>
      </tr>
    </thead>
    <tbody>
      {
        reply.factories.map((factory) => (
          <tr>
            <td>{factory.name}</td>
            <td>{factory.online ? 'yes' : 'no'}</td>
            <td>{formatTimestamp(factory.lastSeenAt)}</td>
            <td>
              {factory.projects
                .map((row) => `${row.projectId} ${row.desired} / ${row.running}`)
                .join(', ') || '-'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>
