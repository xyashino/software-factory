{
  "name": "software-factory",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:sf": "pnpm --filter @repo/factory build:sf && pnpm --filter @repo/factory-web-demo build && pnpm --filter @repo/factory-web-demo deploy --prod apps/factory-web-demo/dist/sf-deps",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "ci:format": "lint-staged",
    "ci:verify": "turbo run //#format:check lint check-types db:check test build --ui=stream",
    "nitpick:check": "pnpm nitpick --check",
    "nitpick:sync": "pnpm nitpick --sync",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@repo/nitpick": "workspace:*",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
